<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Brand palette pulled from the site's app/globals.css (--surface-1 /
      --up-color / --down-color). styles.xml's AppTheme referenced these
      three color names without ever defining them — the freshly generated
      Capacitor template ships an empty values/colors.xml, which would have
      failed the Gradle resource build the first time anyone tried to
      compile this project. Defining them here also gets us a status bar
      (colorPrimaryDark) that matches the site instead of the AppCompat
      default purple/teal.
    -->
    <color name="colorPrimary">#0B0B0B</color>
    <color name="colorPrimaryDark">#0B0B0B</color>
    <color name="colorAccent">#2A78D6</color>
</resources>
